{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${ZCODE_PLUGIN_ROOT}/scripts/hooks/zcode-session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
