{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "evals/runners/**/*.ts", "skills/methodrail-init/scripts/harness-manifest.d.mts", "evals/fixtures/leaderboard-sort/hidden-grader.d.mts", "scripts/upstream-preflight.d.mts", "scripts/check-upstreams.d.mts", "scripts/hooks/session-ledger.d.mts"],
  "exclude": ["dist", "node_modules"]
}
