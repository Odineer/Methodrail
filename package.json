{
  "name": "methodrail",
  "version": "0.9.2",
  "description": "Unified, evidence-driven engineering environment for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "validate": "tsx src/validate.ts",
    "doctor": "tsx src/doctor.ts",
    "eval": "tsx evals/runners/cli.ts",
    "project-hosts": "tsx src/project-family-invariant.ts",
    "check": "tsc --noEmit && npm test && npm run validate && npm run eval",
    "check-upstreams": "node scripts/check-upstreams.mjs",
    "ledger": "tsx evals/runners/ledger-to-run.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Odineer/Methodrail.git"
  },
  "keywords": [
    "agents",
    "skills",
    "methodology",
    "evidence",
    "verification",
    "ai-coding"
  ],
  "dependencies": {
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
